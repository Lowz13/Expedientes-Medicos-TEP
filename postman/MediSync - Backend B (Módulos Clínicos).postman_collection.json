    {
      "name": "3. Archivos Clínicos y Reporte PDF (BB-04 & BB-05)",
      "item": [
        {
          "name": "3.1 Subir Archivo Clínico (Multipart)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code es 200 o 201\", function () {\n    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\n});\n\n// Extraer el nombre del archivo del texto de la respuesta\nvar responseText = pm.response.text();\nvar match = responseText.match(/nombre:\\s*(.+)$/);\n\nif (match && match[1]) {\n    var nombreArchivo = match[1].trim();\n    pm.collectionVariables.set('archivoNombre', nombreArchivo);\n    console.log(\"Variable archivoNombre guardada como:\", nombreArchivo);\n} else {\n    console.error(\"No se pudo extraer el nombre del archivo del texto:\", responseText);\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [
                    "postman-cloud:///1f1e1d2f-e264-4a20-a070-4d1c33048c63"
                  ]
                },
                {
                  "key": "pacienteId",
                  "value": "{{pacienteId}}",
                  "type": "text",
                  "disabled": true
                },
                {
                  "key": "consultaId",
                  "value": "{{consultaId}}",
                  "type": "text",
                  "disabled": true
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/archivos/subir",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "archivos",
                "subir"
              ]
            }
          },
          "response": []
        },
