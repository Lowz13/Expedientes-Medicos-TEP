  "item": [
    {
      "name": "1. Citas y Correo SMTP (BB-01, BB-02, BB-06)",
      "item": [
        {
          "name": "1.1 Registrar Cita (Dispara Correo SMTP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('citaId', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"pacienteId\": \"{{pacienteId}}\",\n    \"medicoId\": \"{{medicoId}}\",\n    \"fechaHora\": \"2026-12-10T10:00:00\",\n    \"correoPaciente\": \"prueba@medisync.local\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/citas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "citas"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.2 Listar Todas las Citas",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/citas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "citas"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.3 Cancelar Cita (PATCH)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Estado cambiado a CANCELADA', function () {",
                  "    pm.expect(jsonData.estado).to.eql('CANCELADA');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
