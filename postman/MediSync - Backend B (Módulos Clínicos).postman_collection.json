    {
      "name": "2. Consultas e Historial Clínico (BB-03 & BB-07)",
      "item": [
        {
          "name": "2.1 Registrar Consulta Médica (Rol MEDICO)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 201 Created', function () {\n    pm.response.to.have.status(201);\n});\nvar jsonData = pm.response.json();\nif (jsonData.id) {\n    pm.collectionVariables.set('consultaId', jsonData.id);\n}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "medico",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "1234",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"pacienteId\": \"{{pacienteId}}\",\n    \"medicoId\": \"{{medicoId}}\",\n    \"diagnostico\": \"Gastritis aguda erosiva\",\n    \"tratamiento\": \"Omeprazol 20mg cada 24 horas en ayunas por 14 días. Dieta blanda y evitar irritantes.\",\n    \"notasMedicas\": \"Paciente refiere dolor epigástrico quemante. Se recomienda control en 2 semanas.\"\n}",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/consultas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "consultas"
              ]
            }
          },
          "response": []
        },
